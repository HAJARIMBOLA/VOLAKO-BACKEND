# Environment variables for production deployment (e.g. Render).
# Never commit real values — set these in your hosting provider's dashboard.

# --- Database (Neon Postgres) ---
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require&channel_binding=require
DB_USERNAME=
DB_PASSWORD=

# --- JWT ---
# Long random string (32+ chars). Rotate it and every refresh token is invalidated.
JWT_SECRET=
# Optional overrides (milliseconds). Defaults: 15 min access, 7 days refresh.
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- CORS ---
# The deployed frontend's origin, no trailing slash (e.g. https://volako.vercel.app)
FRONTEND_URL=

# --- Server ---
# Render sets this automatically; only needed for other hosts.
PORT=8080
